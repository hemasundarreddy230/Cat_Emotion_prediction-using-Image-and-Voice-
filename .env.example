# Environment Variables for CatCare AI

# Google Gemini API Key for AI Content Validation
# Get your API key from: https://ai.google.dev/
# GEMINI_API_KEY=your_gemini_api_key_here

# AI Validation Settings
AI_VALIDATION_ENABLED=true
AI_VALIDATION_STRICT_MODE=true
AI_VALIDATION_MIN_CONFIDENCE=0.7

# Django Settings
DEBUG=true
SECRET_KEY=your_secret_key_here

# Database Settings (if using PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/catcare_db